API_TOKEN=replace-with-long-random-token
API_USERNAME=admin
API_PASSWORD=replace-with-strong-admin-password
CREATOR_USERNAME=creator
CREATOR_PASSWORD=replace-with-strong-creator-password
ADD_USER_ADMIN_TOKEN=replace-with-long-random-add-user-token
APP_HOST=localhost
HTTP_PORT=80
HTTPS_PORT=443
HTTPS_BIND_ADDRESS=127.0.0.1
API_PORT=8001
COOKIE_SECURE=true
UI_SESSION_MAX_AGE_SECONDS=43200
ALLOW_PRIVATE_MEDIA_URLS=false
MAX_UPLOAD_FILE_BYTES=5368709120

POSTGRES_DB=audio_transcribator
POSTGRES_USER=audio_transcribator
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgresql://audio_transcribator:replace-with-strong-postgres-password@localhost:5432/audio_transcribator
DATABASE_CONNECT_RETRIES=30
DATABASE_CONNECT_DELAY_SECONDS=1

BASE_DIR=.
UPLOAD_DIR=./data/uploads
RESULTS_DIR=./data/api_results
MODEL_CACHE_DIR=./data/model_cache
HF_HUB_DISABLE_SYMLINKS_WARNING=1
MAX_CONCURRENT_JOBS=1

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=ollama
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_API_KEY=EMPTY
VLLM_HF_CACHE_DIR=./data/model_cache/vllm-huggingface
VLLM_MAX_MODEL_LEN=3500
VLLM_GPU_MEMORY_UTILIZATION=0.44
SUMMARY_MODEL=Qwen/Qwen3-8B-AWQ
SUMMARY_TOKENIZER_MODEL=Qwen/Qwen3-8B-AWQ
SUMMARY_LOCAL_FILES_ONLY=true
SUMMARY_ENABLE_THINKING=false
SUMMARY_MAX_MODEL_TOKENS=3200
SUMMARY_MAX_CHUNK_TOKENS=2200
SUMMARY_OVERLAP_TOKENS=100
SUMMARY_CHUNK_MAX_TOKENS=450
SUMMARY_FINAL_MAX_TOKENS=700
SUMMARY_CHUNK_CHARS=2500
SUMMARY_REQUEST_TIMEOUT_SECONDS=3600
SUMMARY_REQUEST_RETRIES=2
OLLAMA_REQUEST_TIMEOUT_SECONDS=3600
EDITOR_MODEL=qwen3:8b
EDITOR_CHUNK_CHARS=2500
EDITOR_TEMPERATURE=0.1

WHISPER_COMPUTE_TYPE=float16
WHISPERX_MODEL=large-v3
WHISPERX_DEVICE=cuda
WHISPERX_BATCH_SIZE=8
WHISPERX_VAD_MODEL=./data/model_cache/whisperx/whisperx-vad-segmentation.bin

ENABLE_DIARIZATION=true
PYANNOTE_DEVICE=cuda
HF_TOKEN=
